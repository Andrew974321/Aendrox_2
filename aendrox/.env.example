SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Leave unset in production (defaults to https://www.aendrox.in), or use the www address.
SITE_URL=

# AI sales agent (robot chat). Any OpenAI-compatible Chat Completions API. Server-only; never NEXT_PUBLIC_.
# Local, free (your PC only):  AI_BASE_URL=http://127.0.0.1:11434/v1   AI_MODEL=aendrox
# Cloud (needed on Vercel):    AI_BASE_URL=https://api.openai.com/v1   AI_MODEL=<model name>   AI_API_KEY=<key>
# With none of these set, the chat falls back to preset answers.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Optional: email each new lead to you via Resend (https://resend.com)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# LEAD_FROM_EMAIL=AENDROX Leads <leads@aendrox.in>   (after verifying aendrox.in in Resend)

# Optional: booking link the agent shares after a lead is saved (e.g. Cal.com or Calendly)
BOOKING_URL=

# Optional: Google Search Console HTML-tag verification code
GOOGLE_SITE_VERIFICATION=
